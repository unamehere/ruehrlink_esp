menu "Ruehrlink: Diagnose"

config RL_DIAG_LOG_SIZE
    int "Groesse des Log-Puffers im RAM (Byte)"
    range 2048 32768
    default 8192
    help
        Die letzten Log-Ausgaben der Firmware fuer "Problem melden" in der App
        (GET /api/v1/diag). Liegt fest im internen RAM; Zugangsdaten werden vor
        dem Speichern maskiert.

endmenu
