menu "Ruehrlink: Speicher"

config RL_STORAGE_USE_SD
    bool "microSD-Karte ueber SPI (SDSPI)"
    default y
    help
        Rezepte, Fotos und Programme liegen auf einer microSD-Karte (FAT32), angeschlossen
        ueber SPI. Steckt keine Karte oder ist sie nicht lesbar, greift der Rueckfall unten.

config RL_STORAGE_FLASH_FALLBACK
    bool "Rueckfall: SD-Emulation im internen Flash"
    default y
    help
        Ohne (lesbare) Karte haengt die Bruecke stattdessen ein FAT mit Wear Leveling auf
        der Flash-Partition "storage" ein (Entwicklung, ca. 10 MB). Braucht die Partition
        "storage" in partitions.csv.

if RL_STORAGE_USE_SD

config RL_SD_PIN_MISO
    int "SD: MISO (Karte DAT0)"
    default 18
    help
        Ruehrlink-Platine: IO18.

config RL_SD_PIN_MOSI
    int "SD: MOSI (Karte CMD)"
    default 20
    help
        Ruehrlink-Platine: IO20.

config RL_SD_PIN_SCK
    int "SD: SCK (Karte CLK)"
    default 19
    help
        Ruehrlink-Platine: IO19.

config RL_SD_PIN_CS
    int "SD: CS (Karte DAT3)"
    default 21
    help
        Ruehrlink-Platine: IO21.

config RL_SD_FREQ_KHZ
    int "SD: SPI-Takt in kHz"
    default 20000
    range 400 40000
    help
        20 MHz laeuft mit kurzen Leitungen sicher. Bei Lesefehlern mit fliegender
        Verdrahtung (Steckbrett) auf 10000 oder 4000 senken.

config RL_SD_FORMAT_IF_FAILED
    bool "SD: unlesbare Karte formatieren"
    default n
    help
        Aus: Eine Karte ohne FAT (z. B. exFAT bei Karten ab 64 GB) wird nicht angefasst,
        die Bruecke faellt auf den Flash zurueck. An: Karte wird ohne Rueckfrage formatiert.

endif

config RL_STORAGE_MAX_FILES
    int "Gleichzeitig offene Dateien"
    default 2
    range 1 8
    help
        Jede offene Datei kostet internen RAM (Dateiobjekt + Sektorpuffer). Die Bruecke
        oeffnet hoechstens zwei gleichzeitig (eine Antwort streamen, eine schreiben).

endmenu
