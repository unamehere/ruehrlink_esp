# Rührlink-Platine: ESP32-C6-WROOM-1-N8, 8 MB Flash, kein PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Konsole über die eingebaute USB-Serial/JTAG-Schnittstelle (USB-C), nicht über UART0 (nur Testpunkte)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# WLAN: eigenes AP für die Maschine + Heim-WLAN gleichzeitig
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Webserver / WebSocket für Maschine und App
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

# OTA mit automatischem Rollback (siehe docs/updates.md)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Bluetooth für die Einrichtung per App
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Speicher: lange Dateinamen (Rezept-IDs, Foto-Hashes)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_WL_SECTOR_SIZE_4096=y

# mDNS nur im Heim-WLAN, nicht im Maschinen-WLAN
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n

# App-API: Token schon beim WebSocket-Handshake pruefen; genug Sockets fuer Maschine + Apps
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16

# TLS-Puffer nur bei Bedarf anlegen und nach dem Handshake verkleinern (spart pro Verbindung ~15-20 KB,
# wichtig ohne PSRAM). Achtung: DYNAMIC_FREE_CA_CERT gibt die CA-Kette nach jedem Handshake frei –
# eigene Zertifikate bei jeder Verbindung neu einlesen (F28).
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
